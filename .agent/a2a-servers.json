                    "filePath": {
                        "type": "string",
                        "description": "The path to the file to re-index. Only used for 'reindex' operation."
                    },
                    "symbolName": {
                        "type": "string",
                        "description": "The name of the symbol to search for. Only used for 'search' operation."
                    }
                }
            },
            "output": {
                "type": "object",
                "properties": {
                    "results": {
                        "type": "array",
                        "description": "The search results. Only for 'search' operation.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "filePath": { "type": "string" },
                                "symbol": { "type": "object" }
                            }
                        }
                    }
                }
            }
        }
