{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "dom.iterable"],
    "module": "NodeNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,

    "rootDir": "src",
    "outDir": "src/temp_types",
    "typeRoots": ["./node_modules/@types", "./src/temp_types"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*", "./src/temp_types/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
