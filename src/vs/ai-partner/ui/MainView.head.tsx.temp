import React, { useState, useEffect, useCallback, useRef } from 'react';
import { Header } from './Header';
import { SettingsPage } from './SettingsPage';
import { WelcomeScreen } from './WelcomeScreen';
import { MessageList } from './MessageList';
import { InputArea } from './InputArea';
import { ErrorDisplay } from './ErrorDisplay';
import { PlanView, PlanStep } from './PlanView';
import { vscodeService } from './services/vscode';

export interface DisplayMessage {
	sender: 'user' | 'ai';
	text: string;
	thought?: string;
    senderName?: string;
    timestamp?: string;
    requiresUserInput?: boolean;
    attachments?: Array<{ type: 'file' | 'folder' | 'code' | 'mcp' | 'browser'; uri?: string; label: string; content?: string }>;
    diff?: {
        diffHtml: string;
        originalCode: string;
        modifiedCode: string;
        title: string;
        filePath: string;
        suggestionType: string;
    };
}

type ViewState = 'welcome' | 'chat' | 'settings';

type ChatSessionMeta = {
	id: string;
	title: string;
	createdAt: string;
	messageCount: number;
};

export const MainView: React.FC = () => {
	const [view, setView] = useState<ViewState>('welcome');
    const viewRef = useRef<ViewState>('welcome');
	const [sessions, setSessions] = useState<ChatSessionMeta[]>([]);
	const [activeSessionId, setActiveSessionId] = useState<string>('');
	const [messages, setMessages] = useState<DisplayMessage[]>([]);
	const [plan, setPlan] = useState<PlanStep[]>([]);
	const [error, setError] = useState<{ title: string, message: string } | null>(null);
	const [showHistoryPanel, setShowHistoryPanel] = useState(false);
	const [isAutonomousMode, setAutonomousMode] = useState(false);
	const [statusText, setStatusText] = useState<string | null>(null);
	const [progressMessages, setProgressMessages] = useState<string[]>([]);
    const [slashCommands, setSlashCommands] = useState<{ command: string, description: string }[]>([]);
    const [currentProvider, setCurrentProvider] = useState<'openai' | 'ollama' | 'anthropic' | 'xai' | 'google' | 'groq' | 'openrouter' | undefined>(undefined);
    const [availableModels, setAvailableModels] = useState<string[]>([]);
    const [currentModel, setCurrentModel] = useState<string | undefined>(undefined);
    const [profiles, setProfiles] = useState<Array<{ id: string; name: string; provider?: string; endpoint?: string; model?: string }>>([]);
    const [activeProfileId, setActiveProfileId] = useState<string | null>(null);

	const [isThinking, setIsThinking] = useState(false);

	const mainViewRef = useRef<HTMLDivElement>(null);

    // Pending diffs summary state
    type PendingDiff = {
        diffHtml: string;
        originalCode: string;
        modifiedCode: string;
        title: string;
        filePath: string;
        suggestionType: string;
        senderName?: string;
        timestamp?: string;
    };
    const [pendingDiffs, setPendingDiffs] = useState<PendingDiff[]>([]);
    const [showDiffSummary, setShowDiffSummary] = useState<boolean>(false);
    const diffSummaryRef = useRef<HTMLDivElement>(null);

    // Attachments inserted via context menus or @commands
    type Attachment = { type: 'file' | 'folder' | 'code' | 'mcp' | 'browser'; uri?: string; label: string; content?: string };
    const [attachments, setAttachments] = useState<Attachment[]>([]);
    const lastUserAttachmentsRef = useRef<Attachment[]>([]);
    const dropIncomingRef = useRef<boolean>(false);

    useEffect(() => { viewRef.current = view; }, [view]);

		const handleExtensionMessage = useCallback((event: MessageEvent) => {
			const message = event.data;
			console.log('Received message from extension:', message);

			switch (message.command) {
            case 'slashCommandsResponse':
                setSlashCommands(message.payload || []);
                break;
            case 'llmSettingsResponse':
                if (message.payload) {
                    if (typeof message.payload.llmProvider === 'string') {
                        setCurrentProvider(message.payload.llmProvider);
                    }
                    if (typeof message.payload.model === 'string') {
                        setCurrentModel(message.payload.model);
                    }
                }
                break;
            case 'updateModels':
                if (Array.isArray(message.payload)) {
                    setAvailableModels(message.payload);
                }
                break;
            case 'modelChanged':
                if (typeof message.payload === 'string') {
                    setCurrentModel(message.payload);
                }
                break;
            case 'profilesResponse':
                if (message.payload) {
                    setProfiles(message.payload.profiles || []);
                    setActiveProfileId(typeof message.payload.activeProfileId === 'string' ? message.payload.activeProfileId : null);
                }
                break;
            case 'historyList':
                if (message.payload) {
                    const { sessions: sess, activeId } = message.payload;
                    if (Array.isArray(sess)) setSessions(sess);
                    if (typeof activeId === 'string') setActiveSessionId(activeId);
                }
                break;
            case 'loadHistory':
                // While on Welcome, ignore history loads to prevent flicker and keep recent list visible
                if (welcomeLockRef.current && viewRef.current === 'welcome') {
                    break;
                }
                // Avoid overriding in-flight streaming bubble right after user sends a message
                if (dropIncomingRef.current) {
                    dropIncomingRef.current = false;
                    break;
                }
                try { vscodeService.postMessage({ command: 'debugLog', payload: { source: 'UI', event: 'loadHistory received', meta: { count: Array.isArray(message.payload) ? message.payload.length : 0 } } }); } catch {}
                {
                    const mapped = mapHistoryToDisplayMessages(message.payload || []);
                    setMessages(mapped);
                }
                break;
            case 'activeProfileChanged':
                setActiveProfileId(typeof message.payload === 'string' ? message.payload : null);
                // When active profile changes, provider/model will be refreshed via llmSettingsResponse/updateModels
                break;
            case 'profileSaved':
                // request updated profiles just in case
                vscodeService.postMessage({ command: 'requestProfiles' });
                break;
            case 'profileDeleted':
                vscodeService.postMessage({ command: 'requestProfiles' });
                break;
            case 'insertAttachment':
                if (Array.isArray(message.payload)) {
                    const incoming: any[] = message.payload.filter((x: any) => x && x.label);
                    setAttachments(prev => {
                        const byUri = new Map<string, any>();
                        const pushOrMerge = (att: any) => {
                            const key = `${att.type}:${att.uri || att.label}`;
                            const existing = byUri.get(key) || prev.find(p => (p.uri || p.label) === (att.uri || p.label) && p.type === att.type);
                            if (!existing) {
                                byUri.set(key, att);
                                return;
                            }
                            // Merge label ranges if present like "filename Lxx:yy"
                            const base = (att.label || '').split(' ')[0];
                            const range = (att.label || '').slice(base.length).trim();
                            const exBase = (existing.label || '').split(' ')[0];
                            const exRange = (existing.label || '').slice(exBase.length).trim();
                            if ((att.uri && existing.uri && att.uri === existing.uri) || base === exBase) {
                                const parts = new Set<string>();
                                if (exRange) exRange.split(',').map((s: string) => s.trim()).forEach((s: string) => s && parts.add(s));
                                if (range) range.split(',').map((s: string) => s.trim()).forEach((s: string) => s && parts.add(s));
                                const mergedRange = Array.from(parts).join(', ');
                                const merged = { ...existing, label: mergedRange ? `${exBase} ${mergedRange}` : exBase };
                                byUri.set(key, merged);
                            } else {
                                byUri.set(`${key}#${Math.random()}`, att);
                            }
                        };
                        prev.forEach(p => pushOrMerge(p));
                        incoming.forEach(a => pushOrMerge(a));
                        return Array.from(byUri.values());
                    });
                }
                break;
			case 'analysis':
				setIsThinking(true);
				setProgressMessages(prev => [...prev, message.payload.text]);
				break;
			case 'progressLog':
				if (message.payload && typeof message.payload.text === 'string') {
					setProgressMessages(prev => [...prev, message.payload.text]);
				}
				break;
			case 'displayPlan':
				setIsThinking(true);
				setPlan(message.payload.plan || []);
				break;
			case 'updatePlanStep':
				setPlan(prevPlan => {
					const newPlan = [...prevPlan];
					const { index, status } = message.payload;
					if (newPlan[index]) {
						newPlan[index].status = status;
					}
					return newPlan;
				});
				break;
			case 'statusUpdate':
				setStatusText(message.payload.text);
				break;
            case 'responseStart':
                // Allow subsequent loadHistory updates
                dropIncomingRef.current = false;
                setStatusText(null);
                // Keep plan visible; do not clear here
                setMessages(prev => [...prev, { sender: 'ai', text: '', attachments: lastUserAttachmentsRef.current && lastUserAttachmentsRef.current.length ? [...lastUserAttachmentsRef.current] : undefined }]);
                setIsThinking(true);
                break;
            case 'responseChunk':
                setMessages(prev => {
                    if (prev.length === 0 || prev[prev.length - 1].sender !== 'ai') {
                        return [...prev, { sender: 'ai', text: message.payload.text }];
                    }
                    const newMessages = [...prev];
                    const lastMessage = { ...newMessages[newMessages.length - 1] };
                    lastMessage.text += message.payload.text;
                    newMessages[newMessages.length - 1] = lastMessage;
                    return newMessages;
                });
                break;
            case 'responseEnd':
                setStatusText(null);
                setIsThinking(false);
                setMessages(prev => {
                    if (prev.length === 0 || prev[prev.length - 1].sender !== 'ai') return prev;
                    const newMessages = [...prev];
                    const lastMessage = { ...newMessages[newMessages.length - 1] };
                    if (message.payload.thought) {
                        lastMessage.thought = message.payload.thought;
                    }
                    if (!lastMessage.attachments || lastMessage.attachments.length === 0) {
                        if (lastUserAttachmentsRef.current && lastUserAttachmentsRef.current.length) {
                            lastMessage.attachments = [...lastUserAttachmentsRef.current];
                        }
                    }
                    newMessages[newMessages.length - 1] = lastMessage;
                    return newMessages;
                });
                // Clear after attaching to AI message
                lastUserAttachmentsRef.current = [];
                break;
            case 'response':
                // Allow subsequent loadHistory updates
                dropIncomingRef.current = false;
                setStatusText(null);
                setIsThinking(false);
                if (message.payload) {
                    setMessages(prev => [...prev, {
                        sender: 'ai',
                        text: message.payload.text,
                        thought: message.payload.thought,
                        senderName: message.payload.senderName,
                        timestamp: message.payload.timestamp,
                        // SDK-driven UI folding flag
                        requiresUserInput: message.payload.requiresUserInput,
                        attachments: lastUserAttachmentsRef.current && lastUserAttachmentsRef.current.length ? [...lastUserAttachmentsRef.current] : undefined,
                    // Clear after attaching to AI message
                    lastUserAttachmentsRef.current = [];
                }
                break;
			case 'displayDiffInChatBubble':
				// ì±„íŒ… ë²„ë¸” ?€???ë‹¨ ?”ì•½ ë°”ì— ?„ì 
				setStatusText(null);
				// Keep plan during diff prompts
				setIsThinking(false);
				if (message.payload) {
					try { vscodeService.postMessage({ command: 'debugLog', payload: { source: 'UI', event: 'displayDiffInChatBubble received', meta: { filePath: message.payload.filePath, title: message.payload.title, suggestionType: message.payload.suggestionType } } }); } catch {}
					setPendingDiffs(prev => {
						const exists = prev.some(d => d.filePath === message.payload.filePath);
						const next = exists
							? prev.map(d => d.filePath === message.payload.filePath ? { ...d, ...message.payload } : d)
							: [...prev, message.payload];
						return next;
					});
					// ê¸°ë³¸?€ ?«íž˜ ?íƒœ ? ì?
					setShowDiffSummary(false);
					// ì±„íŒ… ë²„ë¸”?ë„ diff ?œì‹œ
					setMessages(prev => [...prev, {
						sender: 'ai',
						text: 'Changes proposed:',
						thought: undefined,
						senderName: message.payload.senderName,
						timestamp: message.payload.timestamp,
						diff: message.payload
					}]);
				}
				break;
			case 'diffBatchApplied':
				// Accept All ?„ë£Œ ???”ì•½ ì´ˆê¸°??				setPendingDiffs([]);
				setShowDiffSummary(false);
				break;
			case 'focusDiffSummary':
				break;
			case 'forceEnable':
				setIsThinking(false);
				setStatusText(null);
				break;
			case 'addUserMessage':
                setMessages(prev => {
                    const nextMsg = { ...message.payload, senderName: 'User', timestamp: new Date().toISOString(), attachments: message.payload.attachments } as any;
                    const last = prev[prev.length - 1];
                    const isDup = last && last.sender === 'user' && last.text === nextMsg.text && JSON.stringify(last.attachments || []) === JSON.stringify(nextMsg.attachments || []);
                    if (isDup) return prev;
                    return [...prev, nextMsg];
                });
                try { lastUserAttachmentsRef.current = Array.isArray(message.payload?.attachments) ? [...message.payload.attachments] : []; } catch {}
                break;
			case 'hideDiff':
				if (message.payload && message.payload.filepath) {
					setMessages(prev => prev.map(msg => {
						if (msg.diff && msg.diff.filePath === message.payload.filepath) {
							return { ...msg, diff: undefined };
						}
						return msg;
					}));
				}
				break;
			case 'hidePlanButtons':
				setPlan([]);
				break;
        }
    }, []);

    useEffect(() => {
        window.addEventListener('message', handleExtensionMessage);
        vscodeService.postMessage({ command: 'loadInitialData' });
        vscodeService.postMessage({ command: 'requestHistory' });
        vscodeService.postMessage({ command: 'getSlashCommands' });
        vscodeService.postMessage({ command: 'requestLlmSettings' });
        vscodeService.postMessage({ command: 'requestModels' });
        vscodeService.postMessage({ command: 'requestProfiles' });
        return () => window.removeEventListener('message', handleExtensionMessage);
    }, [handleExtensionMessage]);

    useEffect(() => {
        const container = mainViewRef.current;
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    }, [messages, progressMessages, pendingDiffs]);

	const mapHistoryToDisplayMessages = (history: any[]): DisplayMessage[] => {
		if (!Array.isArray(history)) return [];
		return history.map((msg: any) => {
            const sender: 'user' | 'ai' = msg.author === 'user' ? 'user' : 'ai';
            let text = '';
            if (Array.isArray(msg.content)) {
                text = msg.content
                    .filter((c: any) => c && (c.text || c.type === 'text'))
                    .map((c: any) => typeof c === 'string' ? c : (c.text ?? ''))
                    .filter((t: string) => !!t)
                    .join('\n');
            }
            return {
                sender,
                text,
                thought: typeof msg.thought === 'string' && msg.thought ? msg.thought : undefined,
                senderName: msg.senderName,
                timestamp: msg.timestamp,
                requiresUserInput: !!(msg as any)?.requiresUserInput
            };
        });
    };

	const handleSendMessage = (messageText: string) => {
    const sendingFromWelcome = (view === 'welcome');
    if (view !== 'chat') setView('chat');
    welcomeLockRef.current = false;
    setError(null);
    setPlan([]);
    setProgressMessages([]);
    // Ignore the next loadHistory to prevent overwriting local bubbles
    dropIncomingRef.current = true;
    if (sendingFromWelcome) {
        // Reset UI to a clean state so we don't continue the last chat
        setShowHistoryPanel(false);
        setMessages([]);
        try { vscodeService.postMessage({ command: 'debugLog', payload: { source: 'UI', event: 'Posting newChat from handleSendMessage (welcome)', meta: { activeSessionId, sessionsLen: (sessions||[]).length } } }); } catch {}
        console.log('[UI] Posting newChat from handleSendMessage (welcome)');
        vscodeService.postMessage({ command: 'newChat' });
    }
    setIsThinking(true);
    // Ensure first AI bubble can reference these attachments even if streaming races with history reload
    try { lastUserAttachmentsRef.current = Array.isArray(attachments) ? [...attachments] : []; } catch {}
    // Optimistically add user message locally; addUserMessage will de-duplicate
    setMessages(prev => [...prev, { sender: 'user', text: messageText, attachments, timestamp: new Date().toISOString(), senderName: 'User' }]);
    vscodeService.postMessage({ command: 'userQuery', query: messageText, attachments });
    setAttachments([]);
};

	const handleNewChat = () => {
    setView('chat');
    setError(null);
    setShowHistoryPanel(false);
    setMessages([]);
    setPlan([]);
    setProgressMessages([]);
    setIsThinking(false);
    dropIncomingRef.current = true;
    try { vscodeService.postMessage({ command: 'debugLog', payload: { source: 'UI', event: 'Posting newChat from handleNewChat (button)' } }); } catch {}
    console.log('[UI] Posting newChat from handleNewChat (button)');
    vscodeService.postMessage({ command: 'newChat' });
};

	const handleShowHistory = () => {
    setShowHistoryPanel(prev => !prev);
    if (!showHistoryPanel) {
        vscodeService.postMessage({ command: 'requestHistory' });
    }
};

	const handleToggleAutonomousMode = (checked: boolean) => {
    setAutonomousMode(checked);
    vscodeService.postMessage({ command: 'setAutonomousMode', enabled: checked });
};

	const handleSelectSession = (sessionId: string) => {
    welcomeLockRef.current = false;
    if (sessionId === activeSessionId) {
        setShowHistoryPanel(false);
        return;
    }
    setShowHistoryPanel(false);
    setView('chat');
    setError(null);
    setMessages([]);
    setPlan([]);
    setProgressMessages([]);
    setIsThinking(false);
    vscodeService.postMessage({ command: 'selectChat', sessionId });
};

	const handleDeleteSession = (sessionId: string) => {
    vscodeService.postMessage({ command: 'deleteChat', sessionId });
};

	const renderHistoryPanel = () => {
		if (!showHistoryPanel) return null;
		return (
			<div className="history-panel">
				<div className="history-header">
					<button className="chevron-btn" onClick={handleShowHistory} aria-expanded={showHistoryPanel} title={showHistoryPanel ? 'Collapse' : 'Expand'}>
						<span className={`codicon ${showHistoryPanel ? 'codicon-chevron-down' : 'codicon-chevron-right'}`} />
					</button>
					<span className="history-title">Chat History</span>
				</div>
				{sessions.length === 0 ? (
					<div className="history-empty">No chat history</div>
				) : (
					<ul style={{ listStyle: 'none', padding: 0, margin: 0, display: 'flex', flexDirection: 'column', gap: 6 }}>
						{sessions.map(s => (
							<li key={s.id} style={{ position: 'relative', display: 'flex', alignItems: 'center' }}>
								<button
									onClick={() => handleSelectSession(s.id)}
									style={{
										width: '100%',
										textAlign: 'left',
										background: s.id === activeSessionId ? 'var(--vscode-list-activeSelectionBackground)' : 'transparent',
										color: s.id === activeSessionId ? 'var(--vscode-list-activeSelectionForeground)' : 'var(--vscode-foreground)',
										border: '1px solid var(--vscode-panel-border)',
										borderRadius: 4,
										padding: '6px 32px 6px 8px',
										overflow: 'hidden',
										textOverflow: 'ellipsis',
										whiteSpace: 'nowrap',
										cursor: 'pointer'
									}}
									title={s.title}
								>
									<span>{s.title}</span>
									<span style={{ float: 'right', color: 'var(--vscode-descriptionForeground)' }}>
										{new Date(s.createdAt).toLocaleString([], { year: '2-digit', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false })}
									</span>
								</button>
								<button
									onClick={() => handleDeleteSession(s.id)}
									title="Delete chat"
									aria-label={`Delete ${s.title}`}
									style={{
										position: 'absolute',
										right: '4px',
										top: '50%',
										transform: 'translateY(-50%)',
										border: 'none',
										background: 'transparent',
										color: 'var(--vscode-icon-foreground)',
										cursor: 'pointer',
										display: 'flex',
										alignItems: 'center',
										justifyContent: 'center',
										padding: '6px',
										fontSize: '16px',
										lineHeight: 1,
										borderRadius: 4
									}}
								>
									&#x1F5D1;
								</button>
							</li>
						))}
					</ul>
				)}
			</div>
		);
	};

	const renderCentralContent = () => {
		if (view === 'settings') return <SettingsPage />;
		if (error) return <ErrorDisplay error={error} />;
		if (view === 'welcome') {
			const recent = [...sessions].slice(-2).reverse();
			return <WelcomeScreen onSendMessage={handleSendMessage} recentSessions={recent} onPickSession={handleSelectSession} />;
		}
		return (
			<MessageList
				messages={messages}
				isThinking={isThinking}
			/>
		);
	};

        const renderDiffSummaryBar = () => {
            if (pendingDiffs.length === 0) return null;
            return (
                <div className="diff-summary-bar" ref={diffSummaryRef}>
                    <div className="diff-summary-header">
                        <button className="chevron-btn" onClick={() => setShowDiffSummary(v => !v)} aria-expanded={showDiffSummary} title={showDiffSummary ? 'Collapse' : 'Expand'}>
                            <span className={`codicon ${showDiffSummary ? 'codicon-chevron-down' : 'codicon-chevron-right'}`} />
                        </button>
                        <span className="diff-summary-title">{pendingDiffs.length} Files</span>
                        <div className="diff-summary-actions">
                            <button className="diff-summary-btn" onClick={() => {
                                // Accept All
                                vscodeService.postMessage({ command: 'acceptAllChanges', payload: pendingDiffs.map(d => ({ filePath: d.filePath, originalCode: d.originalCode, modifiedCode: d.modifiedCode, suggestionType: d.suggestionType })) });
                            }}>Accept All</button>
                            <button className="diff-summary-btn secondary" onClick={() => {
                                vscodeService.postMessage({ command: 'declineAllChanges', payload: pendingDiffs.map(d => ({ filePath: d.filePath })) });
                                setPendingDiffs([]);
                                setShowDiffSummary(false);
                            }}>Reject All</button>
                        </div>
                    </div>
                    {showDiffSummary && (
                        <ul className="diff-file-list">
                            {pendingDiffs.map(d => (
                                <li key={d.filePath} className="diff-file-item" title={d.title}>
                                    <span className="file-title" onClick={() => {
                                        vscodeService.postMessage({ command: 'showDiff', originalCode: d.originalCode, modifiedCode: d.modifiedCode, title: d.title || d.filePath });
                                    }}>{d.title || d.filePath}</span>
                                    <div className="file-actions">
                                        <button className="file-action-btn accept" onClick={() => {
                                            vscodeService.postMessage({ command: 'acceptChange', filePath: d.filePath, originalCode: d.originalCode, modifiedCode: d.modifiedCode, suggestionType: d.suggestionType });
                                            setPendingDiffs(prev => prev.filter(x => x.filePath !== d.filePath));
                                        }}>Accept</button>
                                        <button className="file-action-btn reject" onClick={() => {
                                            vscodeService.postMessage({ command: 'declineChange', filePath: d.filePath });
                                            setPendingDiffs(prev => prev.filter(x => x.filePath !== d.filePath));
                                        }}>Reject</button>
                                    </div>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
            );
        };

        // Simple context menu in main viper for sending file to Viper
        const [ctxMenu, setCtxMenu] = useState<{ visible: boolean; x: number; y: number }>({ visible: false, x: 0, y: 0 });
        const onMainViewContextMenu = (e: React.MouseEvent) => {
            e.preventDefault();
            setCtxMenu({ visible: true, x: e.clientX, y: e.clientY });
        };
        const hideCtxMenu = () => setCtxMenu(v => ({ ...v, visible: false }));

        return (
            <div className="app-container">
                <Header
                    onNewChat={handleNewChat}
                    onShowHistory={handleShowHistory}
                    onShowSettings={() => {
                        setView(prev => {
                            const next = prev === 'settings' ? 'chat' : 'settings';
                            if (next === 'settings') { setPlan([]); }
                            return next;
                        });
                    }}
                    isAutonomousMode={isAutonomousMode}
                    onToggleAutonomousMode={handleToggleAutonomousMode}
                    model={currentModel}
                    models={availableModels}
                    profiles={profiles.map(p => ({ id: p.id, name: p.name }))}
                    activeProfileId={activeProfileId}
                    onChangeModel={(m) => {
                        setCurrentModel(m);
                        vscodeService.postMessage({ command: 'setModel', payload: { model: m } });
                    }}
                    onChangeProfile={(id) => {
                        setActiveProfileId(id);
                        vscodeService.postMessage({ command: 'setActiveProfile', payload: { id } });
                        // After setting active profile, also refresh settings/models
                        vscodeService.postMessage({ command: 'requestLlmSettings' });
                        vscodeService.postMessage({ command: 'requestModels' });
                    }}
                />

                {renderHistoryPanel()}
                {view === 'chat' && (
                    <PlanView plan={plan} isAutonomousMode={isAutonomousMode} />
                )}
                {view !== 'settings' && !!statusText && !isThinking && (
                    <div className="agent-activity" style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '6px 10px', borderBottom: '1px solid var(--vscode-panel-border)' }}>
                        <span className={`codicon codicon-info`} />
                        <span>{statusText}</span>
                    </div>
                )}
                <div className="main-view" ref={mainViewRef} onContextMenu={onMainViewContextMenu} onClick={hideCtxMenu}>
                    {renderCentralContent()}
                </div>
                {ctxMenu.visible && (
                    <div className="vb-context-menu" style={{ position: 'fixed', top: ctxMenu.y, left: ctxMenu.x, zIndex: 1000 }} onClick={hideCtxMenu}>
                        <div className="vb-context-item" onClick={() => {
                            vscodeService.postMessage({ command: 'appendActiveFileAttachment' });
                            hideCtxMenu();
                        }}>Send File to Viper</div>
                    </div>
                )}
                {view !== 'settings' && (
                    <>
                        {renderDiffSummaryBar()}
                        {progressMessages.length > 0 && (
                            <div className="progress-under-bubble">
                                {progressMessages.map((p, i) => (
                                    <div key={i} className="progress-line">{p}</div>
                                ))}
                            </div>
                        )}
                        {/* Follow-ups trigger removed per product decision */}
                        <div className="input-area-container">
                            {/* Recent History (compact) above input. Exclude active and empty sessions */}
                            {(() => {
                                if (view !== 'welcome' && (messages || []).length > 0) return null;
                                let list = (sessions || [])
                                    .filter(s => s.id !== activeSessionId && (s.messageCount || 0) > 0)
                                    .slice(-2)
                                    .reverse();
                                // Fallback: if none match (e.g., only active or empty sessions), show latest 1-2 excluding active
                                if (list.length === 0) {
                                    list = (sessions || [])
                                        .filter(s => s.id !== activeSessionId)
                                        .slice(-2)
                                        .reverse();
                                }
                                if (list.length === 0) return null;
                                return (
                                    <div style={{ margin: '0 0 6px 0' }}>
                                        <ul style={{ listStyle: 'none', padding: 0, margin: 0, display: 'flex', flexDirection: 'column', gap: 6 }}>
                                            {list.map(s => (
                                                <li key={s.id}>
                                                    <button
                                                        onClick={() => handleSelectSession(s.id)}
                                                        style={{
                                                            width: '100%',
                                                            textAlign: 'left',
                                                            background: 'var(--vscode-input-background)',
                                                            color: 'var(--vscode-foreground)',
                                                            border: '1px solid var(--vscode-panel-border)',
                                                            borderRadius: 4,
                                                            padding: '6px 10px',
                                                            overflow: 'hidden',
                                                            textOverflow: 'ellipsis',
                                                            whiteSpace: 'nowrap',
                                                            cursor: 'pointer'
                                                        }}
                                                        title={s.title}
                                                    >
                                                        <span>{s.title}</span>
                                                        <span style={{ float: 'right', color: 'var(--vscode-descriptionForeground)', position: 'relative', top: '2px' }}>
                                                            {new Date(s.createdAt).toLocaleString([], { year: '2-digit', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false })}
                                                        </span>
                                                    </button>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                );
                            })()}
                            <InputArea
                                onSendMessage={handleSendMessage}
                                disabled={isThinking}
                                commands={slashCommands}
                                attachments={attachments}
                                onRemoveAttachment={(label: string) => setAttachments(prev => prev.filter(a => a.label !== label))}
                                onClearAttachments={() => setAttachments([])}
                            />
                        </div>
                    </>
                )}
            </div>
        );
    };

